<Window x:Class="HR_Codex_v0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HR_Codex_v0.ViewModels"
        Title="HR_Codex_v1.0 正式版"
        Height="900" Width="1600"
        MinHeight="720" MinWidth="1200"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/bitbug_favicon.ico">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource HoloGridBrush}" IsHitTestVisible="False"/>

        <Border Grid.Column="0"
                Background="{StaticResource NavBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,20,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Image Source="Resources/bitbug_favicon.ico"
                               Width="32"
                               Height="32"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="武汉大学电波传播实验室"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="C/X 波段非线性雷达监控台"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MODULES" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource NavButton}" Content="连接设置" Command="{Binding NavCommand}" CommandParameter="Connection" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="指令控制" Command="{Binding NavCommand}" CommandParameter="Command" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="转台控制" Command="{Binding NavCommand}" CommandParameter="Motion" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="参数配置" Command="{Binding NavCommand}" CommandParameter="Config" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="实时采集" Command="{Binding NavCommand}" CommandParameter="Acquisition" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="信号处理" Command="{Binding NavCommand}" CommandParameter="Processing" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="点云检测" Command="{Binding NavCommand}" CommandParameter="Detection"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,24,0,0">
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="UDP LINK" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="Transparent" Margin="20">
            <ContentPresenter Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>

