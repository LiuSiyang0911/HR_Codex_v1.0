<UserControl x:Class="HR_Codex_v0.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HR_Codex_v0.ViewModels"
             Background="{StaticResource BgBrush}">
    <UserControl.DataContext>
        <vm:AcquisitionViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="采集控制" Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="单次采集" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="停止采集" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="循环采集" Style="{StaticResource SecondaryButton}" Command="{Binding CyclicCommand}"/>
                <TextBlock Grid.Column="4" Text="循环状态" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="5" Text="{Binding IsCyclic}" Style="{StaticResource MetricValueText}" FontSize="14" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="文件操作" Grid.Row="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="数据标签" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding DataTag, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="保存数据时追加到文件名，用于区分实验场景或批次"/>
                <Button Grid.Column="3" Content="保存数据" Style="{StaticResource SecondaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="读取文件" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="采集状态" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="已接收" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReceivedMb, StringFormat={}{0:F2}}" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text=" MB" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="目标" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetMb, StringFormat={}{0:F2}}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text=" MB" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="6"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
