<UserControl x:Class="HR_Codex_v0.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HR_Codex_v0.ViewModels"
             xmlns:ScottPlot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
             Background="{StaticResource BgBrush}">
    <UserControl.DataContext>
        <vm:ProcessingViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="处理模式" Grid.Row="0" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="PPI" IsEnabled="False"/>
                    <RadioButton Content="FFT" IsEnabled="False"/>
                    <RadioButton Content="RDM" IsChecked="True" IsEnabled="False"/>
                    <RadioButton Content="RDM_ref" IsEnabled="False"/>
                    <RadioButton Content="RDM_in" IsEnabled="False"/>
                    <RadioButton Content="TD" IsEnabled="False"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="手动处理"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ProcessCommand}"
                        VerticalAlignment="Center"
                        Width="108"
                        Margin="24,0,0,0"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="数据保存" Grid.Row="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="132"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="保存位置" Style="{StaticResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SaveFilePath, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsSavePathEditable}"
                         FontFamily="Consolas"
                         FontSize="12"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseSavePathCommand}" Width="84" HorizontalAlignment="Left"/>
                <Button Grid.Column="3" Content="开始保存" Style="{StaticResource PrimaryButton}" Command="{Binding StartSaveCommand}" IsEnabled="{Binding CanStartRawDataSave}" Width="100" HorizontalAlignment="Left"/>
                <Button Grid.Column="4" Content="停止保存" Style="{StaticResource DangerButton}" Command="{Binding StopSaveCommand}" IsEnabled="{Binding CanStopRawDataSave}" Width="100" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SavedRawDataGb, StringFormat={}{0:F3}}" Style="{StaticResource MetricValueText}" FontSize="14"/>
                    <TextBlock Text=" GB / 10 GB" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{StaticResource AccentBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding SaveStatusMessage}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="距离剖面图" Style="{StaticResource ChartTitleText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <ScottPlot:WpfPlot Grid.Row="1" x:Name="PlotProfile" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="检测点云图" Style="{StaticResource ChartTitleText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button Content="清除" Command="{Binding ClearPointsCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="56" ToolTip="清除点云"/>
                    </Grid>
                    <ScottPlot:WpfPlot Grid.Row="1" x:Name="PlotPoints" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource ChartPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="距离多普勒谱" Style="{StaticResource ChartTitleText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <ScottPlot:WpfPlot Grid.Row="1" x:Name="PlotRdm" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <ScottPlot:WpfPlot x:Name="PlotDisp" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>

