<Window x:Class="UdpDataSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDP 数据发送测试工具"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Icon="Resources/bitbug_favicon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="测试数据文件" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Medium" Margin="0,0,0,12"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathBox" Text="Q:\data\HR_data\H1_197_H2_300_卓尔南20m_3.dat" Margin="0,0,12,0"/>
                    <Button Grid.Column="1" Content="选择文件" Click="BrowseButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="UDP 与速率参数" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Medium" Margin="0,0,0,12"/>
                <UniformGrid Grid.Row="1" Columns="4" Rows="3">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="目标 IP"/>
                        <TextBox x:Name="TargetIpBox" Text="127.0.0.1"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="目标端口"/>
                        <TextBox x:Name="TargetPortBox" Text="20202"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="源 IP（空=任意）"/>
                        <TextBox x:Name="SourceIpBox" Text="127.0.0.1"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="源端口"/>
                        <TextBox x:Name="SourcePortBox" Text="23480"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="UDP 包长 bytes"/>
                        <TextBox x:Name="PacketSizeBox" Text="1400"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="采样率 MHz"/>
                        <TextBox x:Name="SampleRateBox" Text="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="每采样字节数"/>
                        <TextBox x:Name="BytesPerSampleBox" Text="4"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="速率倍率"/>
                        <TextBox x:Name="RateScaleBox" Text="0.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,12,0">
                        <CheckBox x:Name="LoopBox" Content="循环播放文件" IsChecked="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,12,0">
                        <CheckBox x:Name="WaitAckBox" Content="记录 ACK" IsChecked="True"/>
                    </StackPanel>
                    <TextBlock x:Name="RateHintText" Margin="0,12,12,0" Text="目标速率: 38.15 MiB/s"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="StartButton" Content="开始发送" Style="{StaticResource AccentButton}" Click="StartButton_Click" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" x:Name="StopButton" Content="停止" Style="{StaticResource DangerButton}" Click="StopButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="刷新速率" Click="RefreshRateButton_Click" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="3" x:Name="StatusText" Text="空闲" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,12">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="已发送"/>
                    <TextBlock x:Name="SentBytesText" Text="0.00 MiB" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="实时速率"/>
                    <TextBlock x:Name="SpeedText" Text="0.00 MiB/s" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="UDP 包数"/>
                    <TextBlock x:Name="PacketCountText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="耗时"/>
                    <TextBlock x:Name="ElapsedText" Text="00:00:00" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="日志" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Medium" Margin="0,0,0,12"/>
                <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
